# MindPalace settings. install.sh writes this file to ~/.mindpalace/mindpalace.conf.
# Edit that copy after install; hooks read it on every run.

# Vaults: install.sh writes this section at the top of the file. You name them; as many as you like.
#   VAULTS="personal work"            names (letters, digits, - or _)
#   DEFAULT_VAULT="personal"          used when you work outside every vault and projects folder
#   VAULT_personal="$HOME/Personal"   folder of each vault
#   PROJECTS_personal="$HOME/Projects"   its code folder (each subfolder is a project; may be empty)
# A session inside a vault, or inside one of its projects, uses that vault's memory and journal.

# Extra folders that get the full "brain" memory load (space separated).
BRAIN_DIRS=""

# Your name (used in rules and summaries) and the language notes are written in.
USER_NAME="me"
LANGUAGE="English"

# Folder inside every vault that AI assistants must never read (the guard checks it).
PRIVATE_DIR="private"

# SessionStart character budgets. Lower them to save context.
BUDGET_BRAIN=8000     # when working inside the vault
BUDGET_PROJECT=3000   # when working inside $PROJECTS/<name>

# AI tools MindPalace is connected to (claude, codex, gemini). Change with: install.sh --agents ...
AGENTS="claude"
# Which tool's CLI writes the session summaries (any connected tool can summarize any other's sessions).
SUMMARY_AGENT="claude"
# Small, cheap models for summaries, per tool. Empty = the tool's default.
CLAUDE_SUMMARY_MODEL="haiku"
CLAUDE_SUMMARY_EFFORT="low"
CODEX_SUMMARY_MODEL=""
GEMINI_SUMMARY_MODEL="flash-lite"

# Session summaries run in the background.
SUMMARY_INPUT_CHARS=40000   # last N characters of the conversation sent to the model
MIN_CONV_CHARS=400          # shorter sessions are not summarized

# Working state (locks, offsets, log).
STATE="${MP_STATE:-$HOME/.mindpalace/state}"
