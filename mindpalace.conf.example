# MindPalace settings. install.sh writes this file to ~/.mindpalace/mindpalace.conf.
# Edit that copy after install; hooks read it on every run.

# Vaults: install.sh writes this section at the top of the file. You name them; as many as you like.
#   VAULTS="personal work"            names (letters, digits, - or _)
#   DEFAULT_VAULT="personal"          used when you work outside every vault and projects folder
#   VAULT_personal="$HOME/Personal"   folder of each vault
#   PROJECTS_personal="$HOME/Projects"   its code folder (each subfolder is a project; may be empty)
# A session inside a vault, or inside one of its projects, uses that vault's memory and journal.

# Extra folders that get the full "brain" memory load (space separated).
BRAIN_DIRS=""

# Your name (used in rules and summaries) and the language notes are written in.
USER_NAME="me"
LANGUAGE="English"

# Folder inside every vault that AI assistants must never read (the guard checks it).
PRIVATE_DIR="private"

# SessionStart character budgets. Lower them to save context.
BUDGET_BRAIN=8000     # when working inside the vault
BUDGET_PROJECT=3000   # when working inside $PROJECTS/<name>

# AI tools MindPalace is connected to (claude, codex, gemini). Change with: install.sh --agents ...
AGENTS="claude"
# Which tool's CLI writes the session summaries (any connected tool can summarize any other's sessions).
SUMMARY_AGENT="claude"
# Small, cheap models for summaries, per tool. Empty = the tool's default.
CLAUDE_SUMMARY_MODEL="haiku"
CLAUDE_SUMMARY_EFFORT="low"
CODEX_SUMMARY_MODEL=""
GEMINI_SUMMARY_MODEL="flash-lite"

# Session summaries run in the background.
SUMMARY_INPUT_CHARS=40000   # last N characters of the conversation sent to the model
MIN_CONV_CHARS=400          # shorter sessions are not summarized

# Working state (locks, offsets, log).
STATE="${MP_STATE:-$HOME/.mindpalace/state}"

# Resilience. A failed model call is retried on transient errors (never on login/auth errors).
RETRY_WAIT="20 60"            # seconds to wait before each retry (two retries). Empty = no retries
EMPTY_RETRY_MIN_CHARS=8000    # a long conversation that gets an empty answer is tried once more
RECOVER="on"                  # at session start, recover unsummarized sessions and pending maintenance in the background
OPEN_STALE_SEC=7200           # open-session record without a verifiable PID counts as dead after this idle time

# Maintainer: after each session summary an AI agent sorts inbox notes into the vault, updates SUMMARY.md and
# agent/notes.md, counts corrections in memory/mistakes.md, and a script applies the lessons date rules.
# Only tools with a safe file-edit mode can run it (Claude Code). Codex and Gemini: unsupported, stays off.
MAINTAIN="on"                 # on | off
MAINTAIN_AGENT="claude"       # which tool's CLI edits the vault (empty = nobody)
AUTO_COMMIT="on"              # commit to the vault's git repo (local only; MindPalace NEVER pushes)
CLAUDE_MAINTAIN_MODEL="haiku"
MAINTAIN_TIMEOUT=600
LESSON_TRIAL_DAYS=30          # trial rule that does not repeat this long becomes a rule
LESSON_RETIRE_DAYS=90         # rule that does not repeat this long is archived
LESSON_MAX_RULES=15           # active rules at most; the one unused longest is retired

# Claude Code: file holding a long-lived token (from `claude setup-token`) so background summaries and the
# maintainer work without an interactive login. Whitespace in the file is ignored. Keep it at mode 600
# (chmod 600 FILE); doctor.sh checks this. The value is never logged.
CLAUDE_OAUTH_TOKEN_FILE=""
